# Official TypeSafe JEV through OpenRouter. Never commit .env or key files.
JEV_GATEWAY=auto
OPENROUTER_API_KEY=
# Or point to a local key file:
# OPENROUTER_API_KEY_FILE=openrouter_key
OPENROUTER_MODEL=typesafe/jev-1.13
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Alternatively, connect directly to TypeSafe. Set JEV_GATEWAY=typesafe.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
